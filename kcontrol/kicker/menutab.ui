                    <item>
                        <property name="text">
                            <string>Kickoff</string>
                        </property>
                    </item>
                    <item>
                        <property name="text">
                            <string>Trinity Classic</string>
                        </property>
                    </item>
                    <property name="name">
                        <cstring>m_comboMenuStyle</cstring>
                    </property>
                </widget>
                <spacer>
                    <property name="name">
                        <cstring>spacer4</cstring>
                    </property>
                    <property name="orientation">
                        <enum>Horizontal</enum>
                    </property>
                    <property name="sizeType">
                        <enum>Expanding</enum>
                    </property>
