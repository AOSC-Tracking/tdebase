<!DOCTYPE UI><UI version="3.3" stdsetdef="1">
<class>MenuTabBase</class>
<widget class="TQWidget">
    <property name="name">
        <cstring>MenuTabBase</cstring>
    </property>
    <property name="geometry">
        <rect>
            <x>0</x>
            <y>0</y>
            <width>754</width>
            <height>600</height>
        </rect>
    </property>
    <property name="caption">
        <string>MenuTabBase</string>
    </property>
    <grid>
        <property name="name">
            <cstring>unnamed</cstring>
        </property>
