[Desktop Entry]
Name=Universal Sidebar

Comment=Wrapper around Konqueror's navigation panel

Icon=view_sidetree
X-TDE-Library=sidebar_panelextension
X-TDE-UniqueApplet=true
X-TDE-PanelExt-Resizeable=true
X-TDE-PanelExt-StdSizes=true
X-TDE-PanelExt-StdSizeDefault=1
X-TDE-PanelExt-CustomSizeMin=24
X-TDE-PanelExt-CustomSizeMax=400
X-TDE-PanelExt-CustomSizeDefault=200
X-TDE-UniqueExtension=true
X-TDE-PanelExt-Positions=Left,Right
