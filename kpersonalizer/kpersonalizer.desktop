[Desktop Entry]
Type=Application
Exec=kpersonalizer -caption "%c" %i %m
Icon=kpersonalizer
Terminal=false

Name=KPersonalizer

GenericName=Desktop Settings Wizard

X-TDE-autostart-after=kdesktop
X-TDE-autostart-condition=kpersonalizerrc:General:FirstLogin:true
X-DCOP-ServiceType=Multi
Categories=Qt;TDE;Settings;
OnlyShowIn=TDE;
