[Desktop Entry]
Type=Service
Name=MultiColumn View
MimeType=inode/directory
X-TDE-ServiceTypes=KParts/ReadOnlyPart,Browser/View
X-TDE-Library=konq_iconview
X-TDE-BrowserView-AllowAsDefault=true
X-TDE-BrowserView-HideFromMenus=true
X-TDE-BrowserView-Args=MultiColumnView
Icon=view_multicolumn
X-TDE-InitialPreference=9
