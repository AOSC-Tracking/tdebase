#: menuext/system/systemmenu.desktop:4
msgid "Menu of important system places"
msgstr "Μενού σημαντικών τοποθεσιών του συστήματος"

#. Name
#: menuext/tdeprint/printmenu.desktop:2
msgid "Print System"
