#. Name
#: eventsrc:200
msgid "Window Move End"
msgstr "ឈប់​ផ្លាស់ទី​បង្អួច"

#. Comment
#: eventsrc:201
msgid "A window has completed its moving"
msgstr "បង្អួច​មួយ​បាន​បញ្ចប់​ការ​ផ្លាស់ទី​របស់​វា"

#. Name
#: eventsrc:205
msgid "Window Resize Start"
