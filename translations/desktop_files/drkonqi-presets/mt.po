#, c-format
msgid ""
"The application %progname (%appname), pid %pid, crashed and caused the "
"signal %signum (%signame)."
msgstr ""
"Il-programm %progname (%appname), pid %pid, ikkraxxja u kkawża s-sinjal "
"%signum (%signame)."

