#, c-format
msgid ""
"The application %progname (%appname), pid %pid, crashed and caused the "
"signal %signum (%signame)."
msgstr ""
"Aplikacija %progname (%appname), pid %pid se srušila sa signalom %signum "
"(%signame)."

