msgid "Settings preferred for developers"
msgstr "Tchuzes mia inmêyes pa les programeus"

#. Name
#: developerrc:13
#, c-format
msgid ""
"The application %progname (%appname), pid %pid, crashed and caused the "
"signal %signum (%signame)."
msgstr ""
"Li programe %progname (%appname), pid %pid, s' a spotchî et a evoyî l' signå "
"%signum (%signame)."

#. Name
#: developerrc:17
msgid "You might want to fix your program. Take a look at the backtrace tab."
msgstr "Vos pôrîz volou remantchî vos programe. Riwaitîz l' linwete Passêye."

