#, c-format
msgid ""
"The application %progname (%appname), pid %pid, crashed and caused the "
"signal %signum (%signame)."
msgstr ""
"Prográmma %progrname (%appname), pid %pid, reakčánii ja attii signála "
"%signum (%signame)."

