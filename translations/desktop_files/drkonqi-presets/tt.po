#, fuzzy, c-format
msgid ""
"The application %progname (%appname), pid %pid, crashed and caused the "
"signal %signum (%signame)."
msgstr ""
"%pid. PID belän %progname (%appname) yazılımında %signum (%signame) ımlaw "
"belän ütmäslek xata buldı."

