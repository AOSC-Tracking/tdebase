#. Name
#: eventsrc:23
msgid "Silence in monitored session"
msgstr "Im lặng trong các phiên chạy được theo dõi"

#. Comment
#: eventsrc:24
msgid "Silence detected in a monitored session"
msgstr "Im lặng được phát hiện trong một phiên chạy bị theo dõi"

#. Name
#: eventsrc:28
msgid "Session finished with non-zero status"
