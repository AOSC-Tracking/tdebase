#. Name
#: eventsrc:6
msgid "Bell in visible session"
msgstr "Chuông trong các phiên chạy nhìn thấy"

#. Comment
#: eventsrc:7
msgid "Bell emitted within a visible session"
msgstr "Chuông phát ra trong một phiên chạy nhìn thấy"

#. Name
#: eventsrc:12
msgid "Bell in non-visible session"
msgstr "Chuông trong các phiên chạy không nhìn thấy"

