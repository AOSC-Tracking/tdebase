msgstr "Налаштування вигляду та поведінки заголовків вікон"

#. Keywords
#: kcmtwin/twindecoration/twindecoration.desktop:15
msgid ""
"twin;window;manager;border;style;theme;look;feel;layout;button;handle;edge;"
"kwm;decoration;"
msgstr ""
"twin;вікно;менеджер;границя;стиль;тема;вигляд;поведінка;розклад;кнопка;"
"handle;край;kwm;обрамлення;"

