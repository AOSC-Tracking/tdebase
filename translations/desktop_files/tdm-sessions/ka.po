msgstr "CDE-ს მაგვარი სამუშაო დაფა ქოლესტერინის გარეშე"

#. Name
#: xfce4.desktop:6
msgid "XFce 4"
msgstr "XFce 4"

#. Comment
#: xfce4.desktop:8
msgid ""
"The Cholesterol Free Desktop Environment, version 4. A desktop environment "
"reminiscent of CDE"
msgstr "CDE-ს მაგვარი უქოლესტერინო სამუშაო დაფა xfce 4"
