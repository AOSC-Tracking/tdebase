Name=Israel
Region=middleeast
Languages=he,ar
#DecimalSymbol=
#ThousandsSeparator=
CurrencySymbol=₪
#MonetaryDecimalSymbol=
#MonetaryThousandsSeparator=
#PositiveSign=
#NegativeSign=-
